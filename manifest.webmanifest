{
  "name": "Hampta Mountain Body",
  "short_name": "Hampta",
  "description": "Daily Hampta Pass trek preparation tracker.",
  "id": "./",
  "start_url": "./index.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#06100e",
  "theme_color": "#07110f",
  "lang": "en-IN",
  "dir": "ltr",
  "categories": ["health", "fitness", "productivity"],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Today",
      "short_name": "Today",
      "description": "Open today's Hampta stage.",
      "url": "./index.html?tab=today",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Duel",
      "short_name": "Duel",
      "description": "Open Tarun vs Sudhanshu matchup.",
      "url": "./index.html?tab=duel",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Protein",
      "short_name": "Protein",
      "description": "Log recovery fuel for today.",
      "url": "./index.html?tab=protein",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Signal",
      "short_name": "Signal",
      "description": "Log pain, sleep, energy, and effort.",
      "url": "./index.html?tab=body",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Progress & Backup",
      "short_name": "Progress",
      "description": "Open proof goals, coach brief, backup, and device settings.",
      "url": "./index.html?tab=backup",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
